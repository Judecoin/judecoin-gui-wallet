{
  "name": "jude-wallet-gui",
  "version": "4.0.1",
  "description": "Desktop GUI wallet for Judecoin cryptocurrency",
  "homepage": "https://github.com/Judecoin",
  "repository": {
    "type": "git",
    "url": "https://github.com/Judecoin/judecoin-gui-wallet.git"
  },
  "productName": "jude-wallet-gui",
  "desktopName": "jude-wallet-gui.desktop",
  "cordovaId": "com.jude.wallet",
  "author": {
    "name": "Judecoin Community"
  },
  "private": true,
  "scripts": {
    "dev": "quasar dev -m electron",
    "build": "quasar build -m electron --publish=never",
    "windows": "quasar build -m electron --publish=never -T win -A x64",
    "linux": "quasar build -m electron --publish=never -T linux",
    "test:linux": "node scripts/check-linux-release.js",
    "test:unified": "node scripts/check-unified-source.js",
    "test:service-node-status": "node scripts/check-service-node-status.js",
    "test:v4-release": "node scripts/check-v4-release.js",
    "test:release-hygiene": "node scripts/check-release-hygiene.js",
    "test:runtime-safety": "node scripts/check-runtime-safety.js",
    "test:unlock-relay": "node scripts/check-unlock-relay.js",
    "test:unlock-history": "node scripts/check-unlock-history.js",
    "test:gateway-update-gate": "node scripts/check-gateway-update-gate.js",
    "test:transaction-types": "node scripts/check-transaction-type-compatibility.js",
    "build-publish": "quasar build --mode electron --publish=always",
    "windows-publish": "quasar build --mode electron --publish=always -T win",
    "lint": "eslint --fix .",
    "format": "prettier --write \"**/*.+(js|jsx|json|yml|yaml|css|md|vue)\"",
    "ready": "npm run lint && npm run format"
  },
  "dependencies": {
    "axios": "1.20.0",
    "core-js": "3.49.0",
    "electron-is-dev": "1.2.0",
    "electron-window-state": "^5.0.3",
    "fs-extra": "^8.1.0",
    "object-assign-deep": "^0.4.0",
    "portscanner": "^2.2.0",
    "promise-queue": "^2.2.5",
    "qrcode.vue": "^1.6.1",
    "quasar": "^1.13.1",
    "upath": "^1.2.0",
    "vue-i18n": "^8.9.0",
    "vue-timeago": "^5.1.2",
    "vuelidate": "^0.7.4"
  },
  "devDependencies": {
    "@quasar/app": "^2.0.8",
    "@quasar/extras": "^1.9.4",
    "babel-eslint": "^10.1.0",
    "babel-loader": "8.4.1",
    "devtron": "^1.4.0",
    "dotenv": "^8.1.0",
    "electron": "43.8.3",
    "electron-builder": "26.15.3",
    "electron-debug": "^2.1.0",
    "electron-devtools-installer": "^2.2.4",
    "eslint": "^5.16.0",
    "eslint-config-prettier": "^6.12.0",
    "eslint-friendly-formatter": "^4.0.1",
    "eslint-loader": "^2.2.1",
    "eslint-plugin-import": "^2.16.0",
    "eslint-plugin-node": "^8.0.1",
    "eslint-plugin-prettier": "^3.1.4",
    "eslint-plugin-promise": "^4.0.1",
    "eslint-plugin-vue": "^5.2.3",
    "husky": "^4.2.3",
    "lint-staged": "^10.0.8",
    "prettier": "^1.19.1",
    "sass-loader": "^7.1.0",
    "strip-ansi": "^3.0.1"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.+(js|jsx|vue)": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.+(json|yml|yaml|css|md)": "prettier --write"
  },
  "engines": {
    "node": ">= 8.9.0",
    "npm": ">= 5.6.0",
    "yarn": ">= 1.6.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie <= 10"
  ]
}
