@css {
  /* Jude Desktop Wallet — Emerald theme, dark/light toggle */

  /* Dark is the default (no class needed, avoids first-paint flash) */
  body {
    --jude-bg: #0D1117;
    --jude-bg-alt: #161B22;
    --jude-bg-header: #090C10;
    --jude-bg-hover: #1C2128;
    --jude-bg-input: #161B22;
    --jude-bg-overlay: rgba(0,0,0,0.6);
    --jude-border: #30363D;
    --jude-border-light: #21262D;
    --jude-text: #E6EDF3;
    --jude-text-dim: #8B949E;
    --jude-text-muted: #6E7681;
    --jude-text-inverse: #ffffff;
    --jude-accent: #238636;
    --jude-accent-hover: #2EA043;
    --jude-accent2: #58A6FF;
    --jude-accent2-hover: #388BFD;
    --jude-purple: #8957E5;
    --jude-positive: #3FB950;
    --jude-negative: #F85149;
    --jude-warning: #D29922;
    --jude-selection: rgba(31,111,235,0.4);
    --jude-scrollbar-track: #0D1117;
    --jude-scrollbar-thumb: #30363D;
    --jude-balance-gradient: linear-gradient(135deg, #0D1117, #161B22);
    --jude-balance-text: #E6EDF3;
    --jude-balance-border: #30363D;
  }

  body.light {
    --jude-bg: #FFFFFF;
    --jude-bg-alt: #F6F8FA;
    --jude-bg-header: #F6F8FA;
    --jude-bg-hover: #EAEEF2;
    --jude-bg-input: #FFFFFF;
    --jude-bg-overlay: rgba(27,31,36,0.5);
    --jude-border: #D0D7DE;
    --jude-border-light: #E1E4E8;
    --jude-text: #1F2328;
    --jude-text-dim: #57606A;
    --jude-text-muted: #8C959F;
    --jude-text-inverse: #FFFFFF;
    --jude-accent: #238636;
    --jude-accent-hover: #1A7F37;
    --jude-accent2: #0969DA;
    --jude-accent2-hover: #0550AE;
    --jude-purple: #8250DF;
    --jude-positive: #1A7F37;
    --jude-negative: #CF222E;
    --jude-warning: #9A6700;
    --jude-selection: rgba(35,134,54,0.2);
    --jude-scrollbar-track: #F6F8FA;
    --jude-scrollbar-thumb: #D0D7DE;
    --jude-balance-gradient: linear-gradient(135deg, #FFFFFF, #F6F8FA);
    --jude-balance-text: #1F2328;
    --jude-balance-border: #D0D7DE;
  }

  /* q-layout only paints one viewport; overflowing pages (e.g. welcome wizard
     step 2) reveal body behind it, so body itself must follow the theme */
  body {
    background: var(--jude-bg);
  }

  /* Quasar utility class overrides */
  body .bg-primary { background: #238636 !important; }
  body .text-primary { color: #238636 !important; }

  /* Buttons using the dark `accent`/`secondary` palette colors (tab strips,
     clear/copy/sweep buttons, language picker) hardcode near-black; retint
     them with theme variables so they follow dark/light switching */
  body .q-btn.bg-accent,
  body .q-btn.bg-secondary {
    background: var(--jude-bg-header) !important;
    color: var(--jude-text) !important;
  }
}
